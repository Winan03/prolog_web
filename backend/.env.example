# Backend — Variables de entorno requeridas
# Copia este archivo como .env y llena los valores

# JWT (genera con: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=CAMBIA_ESTE_VALOR_POR_UNO_SECRETO_LARGO

# Supabase (obten en: Supabase Dashboard → Settings → API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...TU_SERVICE_ROLE_KEY...

# URL del frontend (para CORS)
FRONTEND_URL=https://tu-app.vercel.app
# Para desarrollo local: FRONTEND_URL=http://localhost:3000
